{
  "expo": {
    "name": "AgriShare",
    "slug": "agrishare",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ph.gov.labangan.agrishare"
    },
    "android": {
      "package": "ph.gov.labangan.agrishare",
      "adaptiveIcon": {
        "backgroundColor": "#2f9e44",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.READ_MEDIA_IMAGES"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.VIBRATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-asset",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "AgriShare uses your location to geotag crop validation photos as proof of where they were taken."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "AgriShare uses your camera to take a proof-of-planting photo for crop validation.",
          "photosPermission": "AgriShare uses your photo library so you can choose a profile picture.",
          "microphonePermission": false
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#2f9e44"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "fba51fdb-82d5-4326-8509-f9297ad1d8a4"
      }
    },
    "owner": "kryz23",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/fba51fdb-82d5-4326-8509-f9297ad1d8a4"
    }
  }
}
