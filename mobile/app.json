{
  "expo": {
    "name": "AgriShare",
    "slug": "agrishare",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ph.gov.labangan.agrishare"
    },
    "android": {
      "package": "ph.gov.labangan.agrishare",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-asset",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "AgriShare uses your location to geotag crop validation photos as proof of where they were taken."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "AgriShare uses your camera to take a proof-of-planting photo for crop validation."
        }
      ],
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "fba51fdb-82d5-4326-8509-f9297ad1d8a4"
      }
    },
    "owner": "kryz23"
  }
}
